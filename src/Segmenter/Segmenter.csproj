<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JiebaNet.Segmenter</RootNamespace>
    <AssemblyName>JiebaNet.Segmenter</AssemblyName>
    <PackageId>Kekincai.JiebaNet.Segmenter</PackageId>
    <Description>Chinese text segmentation for .NET 10 with embedded dictionaries and no third-party runtime dependencies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/*" LogicalName="JiebaNet.Resources.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="JiebaNet.Segmenter.Tests" />
  </ItemGroup>
</Project>
