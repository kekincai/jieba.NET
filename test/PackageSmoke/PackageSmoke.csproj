<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePackages)' != 'true'">
    <ProjectReference Include="../../src/Segmenter/Segmenter.csproj" />
    <ProjectReference Include="../../src/Analyser/Analyser.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackages)' == 'true'">
    <PackageReference Include="Kekincai.JiebaNet.Segmenter" Version="$(Version)" />
    <PackageReference Include="Kekincai.JiebaNet.Analyser" Version="$(Version)" />
  </ItemGroup>
</Project>
